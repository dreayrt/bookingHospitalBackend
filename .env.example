# Application Port
PORT=8080

# Database Configuration (MariaDB / MySQL)
# Khi chạy qua Docker Compose, DB_HOST trỏ tới tên service 'mysql'
DB_HOST=mysql
DB_PORT=3306
DB_USER=proxyDatabase
DB_PASSWORD=your_secure_password_here
DB_NAME=hospital_management_desktop_system
DATABASE_URL="mysql://proxyDatabase:your_secure_password_here@mysql:3306/hospital_management_desktop_system"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# SePay Payment Gateway & Webhook
SEPAY_ACCOUNT=0868422026
SEPAY_BANK=MB
SEPAY_WEBHOOK_TOKEN=your_webhook_token_here

# Gmail SMTP Service Credentials
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password_here

# Redis Configuration (Docker container name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
